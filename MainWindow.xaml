<Window x:Class="SnazzySpinTheWheel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SnazzySpinTheWheel.Controls"
        Title="Snazzy Spin The Wheel"
        Width="900"
        Height="980"
        WindowStartupLocation="CenterScreen"
        Background="PowderBlue">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"
                   FontSize="54"
                   Foreground="White"
                   Text="▼" />

        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="560"
              Height="560">
            <controls:WheelControl Wheel="{Binding Wheel}"
                                   RotationDegrees="{Binding WheelRotationDegrees}" />

            <Button Width="120"
                    Height="120"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Command="{Binding SpinCommand}"
                    FontSize="26"
                    FontWeight="Bold"
                    Background="#FF303030"
                    Foreground="White"
                    BorderBrush="White"
                    BorderThickness="2"
                    Content="Spin!" />
        </Grid>

        <TextBox Grid.Row="2"
                 Margin="0,20,0,0"
                 HorizontalAlignment="Center"
                 Width="240"
                 Height="40"
                 FontSize="20"
                 FontWeight="SemiBold"
                 TextAlignment="Center"
                 IsReadOnly="True"
                 Background="#FF2B2B2B"
                 Foreground="White"
                 BorderBrush="White"
                 Text="{Binding ResultText, Mode=OneWay}" />
    </Grid>
</Window>
